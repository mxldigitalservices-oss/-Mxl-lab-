# Imagen del servicio runner: intérpretes y compiladores, usuario sin privilegios.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs gcc g++ libc6-dev ruby php-cli util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir flask==3.0.3 gunicorn==22.0.0 requests==2.32.3
RUN useradd -m -u 10001 runner
WORKDIR /app
COPY languages.py ./
COPY runner/ ./runner/
ENV PYTHONPATH=/app
USER runner
CMD gunicorn runner.runner_app:app --workers 1 --threads 8 --timeout 60 --bind 0.0.0.0:${PORT:-8080}
