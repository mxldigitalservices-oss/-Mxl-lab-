# Copia este archivo a .env para desarrollo local.
# En Railway estas variables las inyectan los plugins de base de datos.
DATABASE_URL=postgresql://mxl:mxl@localhost:5432/mxl
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
MONGO_DB=mxl

# --- Ejecución de código (servicio runner) ---
# Producción: URL pública del servicio runner y su token (mínimo 32 caracteres aleatorios).
RUNNER_URL=
RUNNER_TOKEN=
# Solo desarrollo local: ejecuta el código en este mismo proceso (NUNCA en producción).
ALLOW_LOCAL_EXEC=1
